# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Server Configuration
API_PORT=8000
UI_PORT=8001
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent_logs.json

# Agent Configuration
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# Data Configuration
DATA_PATH=data/
MAX_FILE_SIZE=500000000
