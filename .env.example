# ============================================================================
# Oil & Gas Analytics - Environment Configuration
# Copy this file to `.env` for local development. In production, inject these
# variables directly (e.g. Docker --env-file, Kubernetes Secrets).
#
# IMPORTANT: empty values below (e.g. ``OPENAI_API_KEY=``) are IGNORED by the
# loader — they will NOT overwrite a value you exported in your shell.
# Either fill the value here OR `export OPENAI_API_KEY=...` before running.
# ============================================================================

# --- Runtime ----------------------------------------------------------------
APP_ENV=production          # development | production
DEBUG=true
LOG_LEVEL=INFO
JSON_LOGS=false              # true => one JSON object per log line (prod-friendly)

# --- Sample mode (no API key needed) ---------------------------------------
# When true the system runs deterministically using tool outputs only.
# Useful for CI, demos, smoke tests, and offline development.
SAMPLE_MODE=false

# --- LLM Provider (REQUIRED unless SAMPLE_MODE=true) -----------------------
# Sourced strictly from environment by app/config.py and app/agents.py.
#OPENAI_API_KEY=<should be from environment variable or add here>
#OPENAI_BASE_URL=<should be from environment variable or add here>             # e.g. https://api.openai.com/v1, https://api.core42.ai/v1

OPENAI_MODEL=gpt-4.1
OPENAI_REQUEST_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# Compass / Azure model aliases (per task). gpt-5.1 is a "reasoning" model;
# the system automatically drops the ``temperature`` field for those.
COMPASS_CHAT_MODEL=gpt-4.1
COMPASS_REASONING_MODEL=gpt-5.1
COMPASS_EMBEDDING_MODEL=text-embedding-3-large
COMPASS_WHISPER_MODEL=whisper-1

# --- HTTP servers -----------------------------------------------------------
API_PORT=8000
UI_PORT=8001
HOST=0.0.0.0
API_BASE_URL=http://localhost:8000

# Comma-separated list. Use specific origins in production (never `*`).
CORS_ORIGINS=*

# Max upload / request payload size in bytes (10 MB default).
MAX_REQUEST_BYTES=10000000

# --- Agent runtime ----------------------------------------------------------
MAX_ITERATIONS=10
AGENT_TIMEOUT=300
MAX_CONTEXT_CHARS=24000
MAX_AGENT_ITERATIONS=3
# --- Data ------------------------------------------------------------------
DATA_PATH=data/
LOG_FILE=logs/agent_logs.json
MAX_FILE_SIZE=500000000

# --- RAG (optional tuning) -------------------------------------------------
# RAG_INDEX_FILE=logs/rag_index.json
# RAG_CHUNK_CHARS=1200
# RAG_CHUNK_OVERLAP=150
# RAG_MAX_CHUNKS_PER_FILE=20
# RAG_EMBED_BATCH=32

# --- Persistent cross-run memory -------------------------------------------
# PERSISTENT_MEMORY_FILE=logs/persistent_memory.json
# PERSISTENT_MEMORY_MAX_PER_KEY=10

# --- Observability ---------------------------------------------------------
# OBS_EVENT_FILE=logs/events.jsonl
# OTEL_ENABLED=false

# --- Production server (gunicorn) ------------------------------------------
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120

# --- Diagnostics -----------------------------------------------------------
# OPENAI_API_KEY is NEVER printed in logs (not even masked). Startup logs
# only show a presence status (``configured`` / ``not configured``) and the
# source (``env`` / ``missing``).

