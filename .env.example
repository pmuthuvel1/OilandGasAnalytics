# OpenAI API Configuration
# OPENAI_API_KEY: Your API key for OpenAI or compatible LLM provider (required)
OPENAI_API_KEY=NA

# OPENAI_MODEL: Model name to use (default: gpt-5.5)
# Use a provider-specific deployment name when OPENAI_BASE_URL points to a compatible API.
OPENAI_MODEL=gpt-5.5

# OPENAI_BASE_URL: Base URL for OpenAI-compatible API endpoints (optional)
# Leave empty to use OpenAI's official API (https://api.openai.com/v1)
# Examples:
#   - https://api.openai.com/v1 (OpenAI official)
#   - https://api.core42.ai/v1 (Core42)
#   - http://localhost:8000/v1 (Local LLM server)
OPENAI_BASE_URL=https://api.core42.ai/v1

# Server Configuration
API_PORT=8000
UI_PORT=8001
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent_logs.json

# Agent Configuration
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# Data Configuration
DATA_PATH=data/
MAX_FILE_SIZE=500000000
