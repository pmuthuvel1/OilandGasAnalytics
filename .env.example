# OpenAI API Configuration
# OPENAI_API_KEY: Your API key for OpenAI or compatible LLM provider (required)
OPENAI_API_KEY=NA

# Model roles
# GPT-4.1: Primary text generation and most agent tasks
OPENAI_PRIMARY_MODEL=gpt-4.1

# GPT-5.1: Advanced reasoning, planning, evaluation, and complex multi-step synthesis
OPENAI_REASONING_MODEL=gpt-5.1

# text-embedding-3-large: Embeddings, RAG, document retrieval, and semantic search
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Whisper API model for speech-to-text. Use provider-specific deployment name if needed.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Backward-compatible alias for older deployments. Prefer OPENAI_PRIMARY_MODEL.
OPENAI_MODEL=gpt-4.1

# OPENAI_BASE_URL: Base URL for OpenAI-compatible API endpoints (optional)
# Leave empty to use OpenAI's official API (https://api.openai.com/v1)
# Examples:
#   - https://api.openai.com/v1 (OpenAI official)
#   - https://api.core42.ai/v1 (Core42)
#   - http://localhost:8000/v1 (Local LLM server)
OPENAI_BASE_URL=

COMPASS_CHAT_MODEL=gpt-4.1
COMPASS_REASONING_MODEL=gpt-5.1
COMPASS_EMBEDDING_MODEL=text-embedding-3-large
COMPASS_WHISPER_MODEL=whisper-1
SAMPLE_MODE=false

# Server Configuration
API_PORT=8000
UI_PORT=8001
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent_logs.json

# Agent Configuration
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# Data Configuration
DATA_PATH=data/
MAX_FILE_SIZE=500000000
